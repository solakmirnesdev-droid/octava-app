# Copy to .env and fill in. Never commit .env itself.

# Where the backend lives, as seen from the Nuxt server. Only the server uses
# this; it is the target of the /api/** proxy.
NUXT_API_BASE=http://localhost:4000/api

# What the browser calls. Leave it as /api so requests go through the proxy
# above — pointing it straight at the backend bypasses the proxy and needs CORS.
NUXT_PUBLIC_API_BASE=/api

# Absolute site URL. Must be the real domain in production: the share-card image
# URLs are built from it, and a localhost value ships links whose picture never
# loads for anyone else.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs the share-card image URLs. Keep it stable across deploys — the signature
# is part of the URL, and Facebook and WhatsApp cache that URL, so a new secret
# silently strips the picture from every link already shared.
# Generate: npx nuxt-og-image generate-secret
NUXT_OG_IMAGE_SECRET=

# Cloudflare Turnstile, public half. Empty = the widget never renders and the
# forms work exactly as they do now. Pair it with TURNSTILE_SECRET_KEY on the
# backend; the widget alone proves nothing.
# Get one at dash.cloudflare.com → Turnstile.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
